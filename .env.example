# Copy to .env and fill in. All optional for the mock; needed for the real AI.

PORT=8787

# AI team: for calling Claude from assistant.js. Never commit the real key.
ANTHROPIC_API_KEY=

# AI team: for the Canvas crawl. Student generates the token in
# Canvas > Account > Settings > New Access Token. Do not collect it via chat.
CANVAS_BASE_URL=https://canvas.pitt.edu
CANVAS_TOKEN=

# Google Calendar one-way sync. In Google Cloud Console, create a Web OAuth
# client and add this exact redirect URI to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback
