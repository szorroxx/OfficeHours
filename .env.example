# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and must never be committed. On Vercel, set these as
# project environment variables instead (see DEPLOY.md).
#
# NOTE: this is now the ONLY .env the project reads. There used to be two --
# one here and one in orchestrator/ -- holding different values for the same
# keys, so which one won depended on which script you happened to run.

# mock = no API calls, free. live = real calls, recorded. replay = play back.
MODE=mock

# https://build.nvidia.com/settings/api-keys  (starts with nvapi-)
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-5

# Tiger Data (Timescale Cloud). Leave blank to use the local file store --
# the site works either way, but nothing persists without this.
DATABASE_URL=postgres://user:pass@host:port/tsdb?sslmode=require

# Fallback student key for the CLI (ask.py). The website scopes each account
# to its own student id automatically; this is only the default.
STUDENT_ID=demo-student

# Where the file store lives when DATABASE_URL is unset.
# STORE_FILE=data.json
# STORE_BACKEND=file        # force one, instead of auto-detecting

# The student's timezone. Canvas stores deadlines in UTC, so without this a
# deadline of 11:59pm shows up as 03:59 the NEXT day -- every late-evening
# due date reads as a day late.
TIMEZONE=America/New_York

CANVAS_SOURCE=local
CANVAS_DIR=canvas_pages

CACHE_DIR=cache
TEMPLATE_DIR=templates

# Set in production so Alexa requests meant for another skill are rejected.
ALEXA_SKILL_ID=

# Domains fetch_page is allowed to read. Anything else is refused.
ALLOWED_DOMAINS=calendar.pitt.edu

# ---------------------------------------------------------------------------
# Quality knobs, best first
# ---------------------------------------------------------------------------

# REASONING is the big one. Nemotron is a reasoning model and "low" sets its
# low_effort flag -- the cheap setting. Tool choice is where this shows:
# picking the wrong tool, missing a tool it has, abandoning a multi-step
# request. Try REASONING=on before touching anything else.
#   off | low | on
REASONING=on

# Moves WITH reasoning, and easy to get wrong. NVIDIA's guidance is ~1.0 when
# reasoning is on and 0.0 when off; 0.0 with reasoning on gives degenerate
# traces. Leave this unset and it's paired automatically (off->0.0, low->0.2,
# on->1.0). Only set it to override that.
# TEMPERATURE=1.0

# How much room one request gets. These were the binding constraint on
# anything multi-step: "clear the noise, estimate each assignment, schedule
# them all" is five tool calls and used to run out of turns halfway through.
MAX_TURNS=14
MAX_TOKENS=8192
TOOL_RESULT_CHARS=40000

# NOTE: THINKING_TOKEN_BUDGET is IGNORED on the hosted build.nvidia.com
# endpoint -- it returns 400 for that parameter, so the client strips it.
# Setting it there does nothing; REASONING=on is what has an effect. It works
# on self-hosted NIM, with NEMOTRON_ALLOW_THINKING_BUDGET=1.
# THINKING_TOKEN_BUDGET=4096

# Which models. Confirm what your key can actually see first:
#   cd orchestrator && python3 smoke_test.py
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# CLAUDE_MODEL=claude-sonnet-5

# NEMOTRON_UNSUPPORTED=
# NEMOTRON_ALLOW_THINKING_BUDGET=1   # only for self-hosted NIM
