# Copy to .env and fill in. All optional for the mock; needed for the real AI.

PORT=8787

# Storage: leave unset to use the local file store (backend/data.json).
# Set to a TigerData/Postgres connection string to use Postgres instead.
# TigerData gives you this in the service dashboard; it looks like:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=
# Set PGSSL=disable only for a local Postgres without TLS.
PGSSL=

# AI team: for calling Claude from assistant.js. Never commit the real key.
ANTHROPIC_API_KEY=

# AI team: for the Canvas crawl. Student generates the token in
# Canvas > Account > Settings > New Access Token. Do not collect it via chat.
CANVAS_BASE_URL=https://canvas.pitt.edu
CANVAS_TOKEN=
